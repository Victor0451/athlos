{
  "name": "@athlos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "migrate:users": "tsx src/scripts/migrate-users.ts"
  },
  "dependencies": {
    "@athlos/approval": "workspace:*",
    "@athlos/auth": "workspace:*",
    "@athlos/config": "workspace:*",
    "@athlos/db": "workspace:*",
    "@athlos/errors": "workspace:*",
    "@athlos/integrations-clock": "workspace:*",
    "@athlos/integrations-email": "workspace:*",
    "@athlos/integrations-legacy-db": "workspace:*",
    "@athlos/integrations-whatsapp": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "dbf-reader": "^1.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@athlos/vitest-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
