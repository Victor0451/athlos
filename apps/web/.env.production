# Production environment for the operator console (apps/web).
#
# `NEXT_PUBLIC_*` env vars are inlined at BUILD TIME by Next.js. This
# file is auto-loaded by `next build` / `next start` (Next.js convention:
# `.env.production` for `next build` + `next start`, `.env.development`
# for `next dev`).
#
# Why this file exists: the operator console runs in the browser
# (localhost or remote) and the apiFetch wrapper calls
# `${NEXT_PUBLIC_API_BASE_URL}/api/v1/...`. If the env var is unset
# at build time, the default `http://localhost:3001` gets baked into
# the bundle, and the browser tries to connect to ITS OWN machine
# instead of the production server — resulting in net::ERR_CONNECTION_REFUSED
# for every apiFetch call. Setting it here makes the value reproducible
# across rebuilds.
#
# The "right" architectural fix is a Next.js proxy for ALL /api/v1/*
# routes (currently only /api/v1/auth/* is proxied, committed in
# df0af6a). That removes the cross-origin concern entirely and gets
# rid of this env var. Tracked as a follow-up slice.

NEXT_PUBLIC_API_BASE_URL=http://100.78.95.34:3001
