# Production env (192.168.1.104 / omarchy — generated 2026-06-26 for v0.5.11 deploy)
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database — points to local docker postgres on athlos-net
DATABASE_URL=postgresql://athlos:athlos@192.168.1.102:5432/athlos
POSTGRES_USER=athlos
POSTGRES_PASSWORD=athlos
POSTGRES_DB=athlos

# JWT secrets (regenerated — rotate quarterly per runbook)
JWT_SECRET=70a2a58547bcb98bb048bb71e5bfb7443b94690c023fdfd320b4f96e52ce2546
JWT_REFRESH_SECRET=a6da29ab2842725391501f430b8cc4f1caf2a220cba29c7aed487c64dffae624

# Legacy DBF source path (bind-mounted read-only)
LEGACY_DB_PATH=/legacy

# SMTP (placeholders — no email sending yet in MVP)
SMTP_HOST=smtp.gorriti.org
SMTP_PORT=587
SMTP_USER=alerts@gorriti.org
SMTP_PASS=change-me
SMTP_FROM=alerts@gorriti.org

# CORS — allow web frontend on localhost:3000
CORS_ORIGINS=http://localhost:3000

# Scheduler cron expressions
DRIFT_DETECTION_CRON=*/15 * * * *
FRESHNESS_REFRESH_CRON=*/5 * * * *
TOKEN_CLEANUP_CRON=0 3 * * *
RECONCILIATION_CRON=0 * * * *
PROMOTION_CRON=0 */6 * * *
AUDIT_RETENTION_DAYS=90

# Backup (placeholders — not active in MVP)
BACKUP_DIR=/var/backups/athlos
BACKUP_RETENTION_DAYS=7
USB_DEVICE=/dev/disk/by-label/athlos-backup-usb
USB_KEYFILE=/root/athlos-usb.key
USB_MAPPER=athlos-backup-usb
USB_MOUNT_POINT=/mnt/athlos-backup-usb
USB_RETENTION_DAYS=30

# Disable backup pre-migration (Dockerfile bug — scripts/*.sh not chmod +x'd)
BACKUP_BEFORE_MIGRATE=false
POSTGRES_HOST=192.168.1.102
POSTGRES_PORT=5432
