{
  "name": "athlos",
  "version": "0.1.0",
  "private": true,
  "description": "Athlos — Club Atlético Gorriti operator console (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./apps/*' build",
    "dev": "pnpm -r --parallel --filter='./apps/*' dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @athlos/db generate",
    "db:migrate": "pnpm --filter @athlos/db migrate",
    "db:studio": "pnpm --filter @athlos/db studio",
    "db:smoke": "pnpm --filter @athlos/db smoke",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
