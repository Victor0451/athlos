# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://athlos:athlos@localhost:5432/athlos
POSTGRES_USER=athlos
POSTGRES_PASSWORD=athlos
POSTGRES_DB=athlos

# ── Auth (REQUIRED — fail-fast in production if empty) ────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-too-openssl-rand-hex-32

# ── Legacy data path (DBF files shared from the old server) ───
# Windows UNC path or POSIX mount point inside Docker.
LEGACY_DB_PATH=\\ServidorGorriti\AplicacionGorriti

# ── SMTP (notifications) ──────────────────────────────────────
SMTP_HOST=smtp.gorriti.org
SMTP_PORT=587
SMTP_USER=alerts@gorriti.org
SMTP_PASS=change-me
SMTP_FROM=alerts@gorriti.org

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list. NO wildcards in production.
CORS_ORIGINS=http://localhost:3000

# ── Scheduler (PR 6a) ──────────────────────────────────────────
# Cron expressions for the 5 default jobs. node-cron 5-field syntax.
# Unsetting RECONCILIATION_CRON disables that job's cron (runNow
# still works for manual triggers). Audit retention is the floor for
# how long audit_events are kept before token-cleanup deletes them.
DRIFT_DETECTION_CRON=*/15 * * * *
FRESHNESS_REFRESH_CRON=*/5 * * * *
TOKEN_CLEANUP_CRON=0 3 * * *
RECONCILIATION_CRON=0 * * * *
PROMOTION_CRON=0 */6 * * *
AUDIT_RETENTION_DAYS=90

# ── Backup (PR Slice B1a) ────────────────────────────────────────
# Local backup directory for scripts/backup.sh
BACKUP_DIR=/var/backups/athlos
# Retention for daily local backups (days)
BACKUP_RETENTION_DAYS=7

# ── Backup USB (PR Slice B1b) ───────────────────────────────────
# LUKS-encrypted external USB for weekly offsite rotation
# Label-based device path — robust to /dev/sdX renumbering after reboot
USB_DEVICE=/dev/disk/by-label/athlos-backup-usb
# LUKS keyfile — chmod 0600, owner root:root (REQUIRED)
USB_KEYFILE=/root/athlos-usb.key
# LUKS mapper name (matches the label above)
USB_MAPPER=athlos-backup-usb
# Mount point for the decrypted USB filesystem
USB_MOUNT_POINT=/mnt/athlos-backup-usb
# Retention for weekly USB backups (days) — older files are deleted after rsync
USB_RETENTION_DAYS=30

# ─── Containerized Deploy (PR Slice C) ───
RUN_MIGRATIONS=true
BACKUP_BEFORE_MIGRATE=true
BUILD_SHA=<git-sha>
NODE_ENV=production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── CI Deploy (PR Slice D) ───
# DEPLOY_HOST: server IP/hostname reachable from GitHub Actions runners
# (production server, migrated from 192.168.1.102 on 2026-07-02)
DEPLOY_HOST=100.78.95.34
# DEPLOY_SSH_KEY: long-lived ed25519 private key, stored as GitHub Secret
# (NEVER commit a real key; placeholder only — set in GitHub repo settings → Secrets)
DEPLOY_SSH_KEY=<paste-private-key-here>
